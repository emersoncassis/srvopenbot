# OpenBot Remoto (Signal + TURN) — aba Environment do Dokploy.
# Gere os segredos com: servidor/scripts/gerar-segredos.sh

OPENBOT_REF=v0.71.0
SIGNAL_HOST=signal.openbot.SEUDOMINIO
TURN_HOST=turn.openbot.SEUDOMINIO
# IP público da VPS (o coturn anuncia este endereço).
TURN_PUBLIC_IP=0.0.0.0

# Igual ao REMOTE_TICKET_PUBLIC_JWKS do OpenBot Contas. Entre aspas simples.
REMOTE_TICKET_PUBLIC_JWKS='{"keys":[{"kty":"EC",...}]}'
# Igual ao REMOTE_AUTH_WEBHOOK_SECRET do OpenBot Contas.
REMOTE_AUTH_WEBHOOK_SECRET=TROCAR

# Segredos só do Remoto (mínimo 32 caracteres cada).
REMOTE_SESSION_SECRET=TROCAR
REMOTE_METRICS_TOKEN=TROCAR
TURN_SHARED_SECRET=TROCAR
