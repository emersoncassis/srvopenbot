# OpenBot cliente (uma instância por pessoa) — aba Environment do Dokploy.
# Gere este bloco pronto com: cliente/novo-cliente.sh <nome> <dominio>

# Nome curto e único (minúsculas, números e hífen). Vira o nome das rotas no Traefik.
INSTANCIA=fulano
# Endereço de acesso pelo navegador.
OPENBOT_HOST=fulano.openbot.SEUDOMINIO
# Versão da imagem oficial do OpenBot (igual ao OPENBOT_REF do servidor, sem o "v").
OPENBOT_TAG=0.71.0
# Tamanho da tela no navegador.
OPENBOT_SCREEN_SIZE=1600x900

# Acesso pelo navegador (usuário e senha pedidos antes de abrir a tela).
OPENBOT_USUARIO=fulano
OPENBOT_SENHA=TROCAR
# Hash da senha no formato htpasswd (openssl passwd -apr1 <senha>), entre aspas simples.
OPENBOT_BASIC_AUTH='fulano:$apr1$...'

# Celular: Signal próprio e endereço público do servidor de contas (obrigatórios).
OPENBOT_REMOTE_SIGNAL_URL=wss://signal.openbot.SEUDOMINIO/v1/signal
OPENBOT_MOBILE_AUTH_API_URL=https://contas.openbot.SEUDOMINIO
