# OpenBot Contas — aba Environment do Dokploy.
# Gere os valores REMOTE_* e SKILLS_ADMIN_TOKEN com: servidor/scripts/gerar-segredos.sh
# (REMOTE_AUTH_WEBHOOK_SECRET e REMOTE_TICKET_PUBLIC_JWKS têm que ser IGUAIS aos do OpenBot Remoto).

# Versão do código do OpenBot (tag do GitHub). Igual ao OPENBOT_TAG dos clientes (sem o "v").
OPENBOT_REF=v0.71.0

# Endereço público usado pelo app de celular (só os caminhos do celular ficam expostos).
CONTAS_HOST=contas.openbot.SEUDOMINIO

# Signal próprio (projeto OpenBot Remoto).
REMOTE_SIGNAL_URL=wss://signal.openbot.SEUDOMINIO/v1/signal
REMOTE_AUTH_WEBHOOK_URL=http://openbot-signal:8081/internal/auth-events

# Chaves dos tíquetes remotos (par ES256 em JWK). Entre aspas simples.
REMOTE_TICKET_KEY_ID=openbot-proprio-1
REMOTE_TICKET_PRIVATE_JWK='{"kty":"EC",...,"kid":"openbot-proprio-1","alg":"ES256","use":"sig"}'
REMOTE_TICKET_PUBLIC_JWKS='{"keys":[{"kty":"EC",...,"kid":"openbot-proprio-1","alg":"ES256","use":"sig"}]}'

REMOTE_AUTH_WEBHOOK_SECRET=TROCAR
SKILLS_ADMIN_TOKEN=TROCAR
